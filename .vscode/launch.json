    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": ["-d",
                    "brisbane_event",
                    "-r",
                    "sunset2",
                    "-q",
                    "sunset1",
                    "--eventlab-dir",
                    "/media/adam/vprdatasets/eventgem"
                    ]
                }
    ]
